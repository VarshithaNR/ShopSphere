# Copy this file to .env and fill in real values. Never commit the real .env file.

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/shopsphere?retryWrites=true&w=majority

# Port the Express server listens on
PORT=5000

# Long, random secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Comma-separated list of allowed frontend origins for CORS in production.
# Leave empty in local development to allow any origin.
# Example: FRONTEND_URL=https://shopsphere.vercel.app
FRONTEND_URL=

# development | production
NODE_ENV=development

# Optional overrides used only by `npm run seed:admin` (backend/createAdmin.js).
# If unset, defaults to admin@shopsphere.com / admin123 — change this in any
# real deployment.
ADMIN_EMAIL=
ADMIN_PASSWORD=
