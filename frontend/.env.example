# Copy this file to .env (local dev) or set these in your hosting provider's
# environment settings (Vercel/Netlify) for production. Never commit the real .env.

# Base URL of the backend API, including the /api prefix.
# Local development (matches backend/.env PORT=5000):
VITE_API_URL=http://localhost:5000/api

# Production example:
# VITE_API_URL=https://shopsphere-api.onrender.com/api
